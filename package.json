{
  "name": "agent-runtime-receipts",
  "version": "0.2.1",
  "private": true,
  "description": "Open runtime receipts for AI agent costs, performance, and outcomes.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "check:boundaries": "node internal/scripts/check-package-boundaries.mjs",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@agent-receipts/core --filter=@agent-receipts/openrouter --filter=@agent-receipts/x402 --filter=@agent-receipts/ori",
    "test:core": "turbo run test --filter=@agent-receipts/core",
    "test:openrouter": "turbo run test --filter=@agent-receipts/openrouter",
    "test:x402": "turbo run test --filter=@agent-receipts/x402",
    "test:ori": "turbo run test --filter=@agent-receipts/ori",
    "test:integrations": "turbo run test --filter=@agent-receipts/openrouter --filter=@agent-receipts/x402 --filter=@agent-receipts/ori",
    "check": "pnpm check:boundaries && turbo run build test",
    "verify": "pnpm clean && pnpm check:boundaries && turbo run build test --force",
    "example:basic": "turbo run build --filter=@agent-receipts/example-basic && node examples/basic/dist/index.js",
    "example:openrouter": "turbo run build --filter=@agent-receipts/example-openrouter-agent && node examples/openrouter-agent/dist/index.js",
    "example:ori": "turbo run build --filter=@agent-receipts/example-ori-runtime-bridge && node examples/ori-runtime-bridge/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.10.8",
    "typescript": "^5.8.3"
  }
}
